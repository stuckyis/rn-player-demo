# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)
# NCP 콘솔 > VPE > Player 관리에서 발급받은 Access Key (앱 ID와 일치해야 함)
EXPO_PUBLIC_VPE_ACCESS_KEY=
# pub(민간) | gov(공공)
EXPO_PUBLIC_VPE_PLATFORM=pub
# (선택) 개발 빌드에서 키 검증에 쓸 앱 ID. 비우면 app.json 의 package/bundleIdentifier(com.vpe.rndemo) 사용
EXPO_PUBLIC_VPE_APP_ID=
# (선택) 재생할 스트림 URL. 비우면 샘플 URL 사용
EXPO_PUBLIC_VOD_URL=
EXPO_PUBLIC_LIVE_URL=
